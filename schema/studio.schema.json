{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3d.devanshutak.xyz/schema/studio.schema.json",
  "title": "Studio",
  "description": "One studio in the /studios/ directory (data/studios/NN-studios.yml). Separate from catalog entries.",
  "type": "object",
  "required": ["name", "url", "description", "hq", "disciplines", "added_at"],
  "additionalProperties": false,
  "$defs": {
    "httpUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "place": {
      "type": "object",
      "required": ["country"],
      "additionalProperties": false,
      "properties": {
        "city": { "type": "string", "minLength": 1, "maxLength": 80 },
        "country": { "type": "string", "minLength": 2, "maxLength": 60 }
      }
    }
  },
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "url": { "$ref": "#/$defs/httpUrl" },
    "description": { "type": "string", "minLength": 10, "maxLength": 200 },
    "hq": { "$ref": "#/$defs/place" },
    "offices": { "type": "array", "items": { "$ref": "#/$defs/place" }, "maxItems": 30 },
    "disciplines": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "animation", "stop-motion", "vfx", "motion-design", "cg", "archviz", "product-viz",
          "games", "cinematics", "virtual-production", "previs", "xr", "experiential",
          "title-design", "live-action", "outsourcing", "mocap"
        ]
      }
    },
    "size": { "enum": ["boutique", "mid", "large"] },
    "founded": { "type": "integer", "minimum": 1850, "maximum": 2100 },
    "careers": { "$ref": "#/$defs/httpUrl" },
    "reel": { "$ref": "#/$defs/httpUrl" },
    "notable": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "social": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instagram": { "$ref": "#/$defs/httpUrl" },
        "linkedin": { "$ref": "#/$defs/httpUrl" },
        "vimeo": { "$ref": "#/$defs/httpUrl" },
        "youtube": { "$ref": "#/$defs/httpUrl" },
        "x": { "$ref": "#/$defs/httpUrl" },
        "behance": { "$ref": "#/$defs/httpUrl" },
        "artstation": { "$ref": "#/$defs/httpUrl" }
      }
    },
    "added_at": { "type": "string", "format": "date-time" },
    "url_status": { "enum": ["ok", "redirect", "broken", "unreachable"] },
    "url_last_verified": { "type": "string", "format": "date" },
    "notes": { "type": "string", "maxLength": 500 }
  }
}
